; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are loss-less and text-based.
; For reference, see the GDScript documentation.

config_version=5

[application]

config/name="Ecos do Encantado"
config/description="RPG Narrativo baseado no Folclore Brasileiro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.1", "4.2", "4.3", "4.4")
config/icon="res://assets/icons/icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
GameState="*res://scripts/core/game_state.gd"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/unused_signal=1
gdscript/warnings/shadowed_variable=1

